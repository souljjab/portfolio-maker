{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-sites-router",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",

  // 모든 1단계 서브도메인(*.YOUR_DOMAIN)을 이 Worker가 받음
  // 주의: 루트 도메인(YOUR_DOMAIN) 자체는 이 패턴에 포함되지 않음
  "routes": [
    { "pattern": "*.YOUR_DOMAIN/*", "zone_name": "YOUR_DOMAIN" }
  ],

  // 사용자 사이트 파일 저장소
  "r2_buckets": [
    { "binding": "SITES", "bucket_name": "portfolio-sites" }
  ],

  "vars": { "ROOT_DOMAIN": "YOUR_DOMAIN" },

  // 로컬 개발(npm run dev): 라우트가 있으면 wrangler dev가 요청 호스트를 라우트 도메인으로 바꿔 버려서
  // 주소(slug)를 알 수 없다 → 라우트 없는 환경으로 띄우고 http://주소.localhost:8788 로 연다.
  "env": {
    "dev": {
      "routes": [],
      "r2_buckets": [{ "binding": "SITES", "bucket_name": "portfolio-sites" }],
      "vars": { "ROOT_DOMAIN": "localhost" }
    }
  }
}
