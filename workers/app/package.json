{
  "name": "portfolio-app-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:render": "npm --prefix ../../apps/web run build:render",
    "dev": "npm run build:render && wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:auth": "node test/auth-check.mjs",
    "deploy": "npm run build:render && npm --prefix ../../apps/web run build && wrangler deploy",
    "test:publish": "node test/publish-check.mjs",
    "test:sync": "node test/sync-check.mjs",
    "test:ai": "node test/ai-check.mjs",
    "eval:directions": "node eval/directions/run-eval.mjs --flow ../../.claude/hillclimb/directions",
    "eval:report": "node eval/directions/build-report-lite.mjs ../../.claude/hillclimb/directions"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
